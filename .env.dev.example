# Local DEVELOPMENT environment — copy to .env.dev (gitignored) and fill in.
#
# This must be a SEPARATE Supabase project from production so test accounts, test data and
# migrations never touch real customers. `npm run dev` refuses to start if any value below
# points at the production project, so a copy/paste mistake can't hurt anything.
#
# One-time setup:
#   1. supabase.com -> New project (name it e.g. "bob-dev"). Save the database password.
#   2. Project Settings > API: copy the Project URL, publishable key, and secret key.
#   3. Project Settings > Database > Connection string: copy the Transaction pooler string
#      (port 6543) into DATABASE_URL and the Session pooler string (port 5432) into DIRECT_URL.
#   4. Fill in this file, then run:  npm run dev:migrate   (creates all tables in the dev DB)
#   5. Start the app:  npm run dev   (http://localhost:4000)

DATABASE_URL="postgresql://postgres.DEVREF:DEVPASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.DEVREF:DEVPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://DEVREF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Stripe TEST mode only (sk_live_ keys are rejected). Placeholders are fine unless you're
# testing billing.
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_PRICE_ID_INDIVIDUAL="price_placeholder"
STRIPE_PRICE_ID_PRODUCER_PLUS="price_placeholder"
STRIPE_PRICE_ID_AGENCY="price_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

PORT=4000
# Any email you sign up with locally that should get the admin console.
ADMIN_EMAILS="you@example.com"
