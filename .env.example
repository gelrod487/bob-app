# Postgres connection string. If using Supabase, use the "Transaction pooler" connection
# string from Project Settings > Database — the direct connection host is IPv6-only and
# won't work from most local networks / CI runners.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth — Project Settings > API
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."   # safe to expose client-side
SUPABASE_SECRET_KEY="sb_secret_..."             # server-only, never expose this

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID_INDIVIDUAL="price_..."
STRIPE_PRICE_ID_PRODUCER_PLUS="price_..."
STRIPE_PRICE_ID_AGENCY="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."   # from the Stripe Dashboard webhook endpoint, or `stripe listen` locally
# Set to "true" to have Stripe calculate sales tax at checkout. Leave unset/false until Stripe Tax is
# fully set up on the account (head office address, registrations) — otherwise checkout fails.
STRIPE_AUTOMATIC_TAX="false"

PORT=4000

# Founding 75 program: the first 75 trial signups lock in 50% off. Create a 50%-off, duration "forever" coupon
# in Stripe with this ID (test mode AND live), then set the same ID in each environment. Leave unset to keep the
# program off (nobody is tagged, no homepage counter, checkout unchanged).
FOUNDING_COUPON_ID="FOUNDING50"
# FOUNDING_LIMIT=75

# Automatic emails (welcome + trial-ending) are sent through Resend's API. Create an API key in the Resend
# dashboard (API Keys, "Sending access") and set it here. Leave unset to switch them off (nothing is sent).
# RESEND_API_KEY="re_..."
# MAIL_FROM="BOB Support <support@getbob.agency>"
# APP_URL="https://getbob.agency"
