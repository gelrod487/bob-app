// BOB — Book of Business
// Prisma schema generated directly from bob-schema.md (v6 — final).
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A producer's `agencyId` (below) is their MEMBERSHIP — whose team roster their own
// personal production counts toward. `ownerId` here is OWNERSHIP — which producer
// manages this specific agency (invite link, Team page, owner draws). These are the same
// producer for a from-scratch Agency Owner, but differ for a promoted downline: producer A
// stays a member of their upline B's agency (their personal numbers keep rolling up to B)
// while separately owning their own new agency that A's own downlines join.
//
// `parentAgencyId` chains a promoted downline's agency to whoever recruited them, capped
// at one level deep for now (see agencyProfitability in src/lib/profitability.js) — B's
// rollup includes A's directly-owned agency's producers, but not a third generation.
model Agency {
  id             String     @id @default(uuid())
  name           String
  ownerId        String?    @unique @map("owner_id")
  parentAgencyId String?    @map("parent_agency_id")
  createdAt      DateTime   @default(now()) @map("created_at")

  owner         Producer?  @relation("AgencyOwner", fields: [ownerId], references: [id])
  parentAgency  Agency?    @relation("AgencySubAgencies", fields: [parentAgencyId], references: [id])
  subAgencies   Agency[]   @relation("AgencySubAgencies")

  producers     Producer[] @relation("AgencyMembers")
  expenses      Expense[]  @relation("AgencyExpenses")
  ownerDraws    OwnerDraw[]
  // Overrides logged against this agency (commission_entry.owner_type = 'agency')
  commissionEntries CommissionEntry[] @relation("AgencyCommissionEntries")
  teamGoals     TeamGoal[]

  @@map("agency")
}

model Producer {
  id                String   @id @default(uuid())
  agencyId          String?  @map("agency_id") // membership — see Agency's doc comment above
  name              String
  email             String   @unique
  supabaseUserId    String   @unique @map("supabase_user_id") // links to Supabase Auth's auth.users.id
  subscriptionTier  String   @default("individual") @map("subscription_tier") // 'individual' | 'agency_owner'
  subscriptionStatus String  @default("inactive") @map("subscription_status") // 'inactive' | 'active' | 'past_due' | 'canceled'
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  createdAt         DateTime @default(now()) @map("created_at")

  agency            Agency?   @relation("AgencyMembers", fields: [agencyId], references: [id])
  ownedAgency       Agency?   @relation("AgencyOwner")
  clients           Client[]
  expenses          Expense[] @relation("ProducerExpenses")
  commissionEntries CommissionEntry[] @relation("ProducerCommissionEntries")
  dailyActivities   DailyActivity[]
  goals             Goal[]

  @@map("producer")
}

// One row per producer per calendar day — the "Today" tally on the Desk (dashboard) and
// the production funnel (dials -> appointments -> presentations/sits -> sales) are both
// built from these. Activity is always logged against the producer doing the dialing, even
// for an Agency Owner rolling up a team, since there's no separate login per sub-producer.
model DailyActivity {
  id            String   @id @default(uuid())
  producerId    String   @map("producer_id")
  date          DateTime @db.Date
  dials         Int      @default(0)
  appointments  Int      @default(0)
  presentations Int      @default(0)
  sales         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  producer Producer @relation(fields: [producerId], references: [id])

  @@unique([producerId, date])
  @@map("daily_activity")
}

// One row per producer per month — powers the "This month vs. goals" progress bars.
// fycTarget is First-Year Commission, i.e. the dollar goal for the month.
model Goal {
  id                 String   @id @default(uuid())
  producerId         String   @map("producer_id")
  month              DateTime @db.Date // always the 1st of the month
  dialsTarget        Int      @default(0) @map("dials_target")
  appointmentsTarget Int      @default(0) @map("appointments_target")
  sitsTarget         Int      @default(0) @map("sits_target")
  salesTarget        Int      @default(0) @map("sales_target")
  fycTarget          Decimal  @default(0) @db.Decimal(10, 2) @map("fyc_target")

  producer Producer @relation(fields: [producerId], references: [id])

  @@unique([producerId, month])
  @@map("goal")
}

// One row per agency per month — the agency-owner-only "This month's Team goals" panel,
// parallel to Goal but scoped to the whole team rather than one producer. Headcount and
// New Writers are target counts the owner sets, same as e.g. Goal.salesTarget; nothing
// here computes the "actual" side yet.
model TeamGoal {
  id               String   @id @default(uuid())
  agencyId         String   @map("agency_id")
  month            DateTime @db.Date // always the 1st of the month
  issuedPaidTarget Decimal  @default(0) @db.Decimal(10, 2) @map("issued_paid_target")
  newWritersTarget Int      @default(0) @map("new_writers_target")
  headcountTarget  Int      @default(0) @map("headcount_target")

  agency Agency @relation(fields: [agencyId], references: [id])

  @@unique([agencyId, month])
  @@map("team_goal")
}

model Client {
  id          String   @id @default(uuid())
  producerId  String   @map("producer_id")
  name        String
  contactInfo Json?    @map("contact_info") // { phone, email }
  createdAt   DateTime @default(now()) @map("created_at")

  producer Producer @relation(fields: [producerId], references: [id])
  policies Policy[]

  @@map("client")
}

model Policy {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  policyNumber   String?  @map("policy_number")
  carrier        String
  productType    String   @map("product_type")
  faceAmount     Decimal? @map("face_amount") @db.Decimal(12, 2)
  monthlyPremium Decimal  @map("monthly_premium") @db.Decimal(10, 2)
  // annualPremium is intentionally NOT stored — compute as monthlyPremium * 12 wherever needed,
  // matching the generated column in the SQL spec. Keeping it derived avoids drift.
  issueDate      DateTime @map("issue_date") @db.Date
  status         String   // 'active' | 'pending' | 'lapsed' | 'declined' | 'withdrawn'
  leadType       String?  @map("lead_type")   // descriptive only, not a real relationship
  leadVendor     String?  @map("lead_vendor") // descriptive only, not a real relationship
  dateSubmitted  DateTime? @map("date_submitted") @db.Date
  approvedDate   DateTime? @map("approved_date") @db.Date
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  client            Client            @relation(fields: [clientId], references: [id])
  commissionEntries CommissionEntry[]
  paymentReminders  PaymentReminder[]

  @@map("policy")
}

model CommissionEntry {
  id         String   @id @default(uuid())
  policyId   String   @map("policy_id")
  ownerType  String   @map("owner_type") // 'producer' | 'agency'
  producerId String?  @map("producer_id") // set when ownerType = 'producer'
  agencyId   String?  @map("agency_id")   // set when ownerType = 'agency'
  entryType  String   @map("entry_type")  // 'advance' | 'additional' | 'chargeback' | 'override' | 'other'
  amount     Decimal  @db.Decimal(10, 2)  // chargebacks stored negative
  entryDate  DateTime @map("entry_date") @db.Date
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  policy   Policy    @relation(fields: [policyId], references: [id])
  producer Producer? @relation("ProducerCommissionEntries", fields: [producerId], references: [id])
  agency   Agency?   @relation("AgencyCommissionEntries", fields: [agencyId], references: [id])

  @@map("commission_entry")
}

model PaymentReminder {
  id               String   @id @default(uuid())
  policyId         String   @map("policy_id")
  monthsAfterIssue Int      @map("months_after_issue") // 10 | 11 | 12 | 13
  reminderDate     DateTime @map("reminder_date") @db.Date
  status           String   @default("pending") // 'pending' | 'completed' | 'dismissed'
  createdAt        DateTime @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id])

  @@map("payment_reminder")
}

model Expense {
  id           String   @id @default(uuid())
  ownerType    String   @map("owner_type") // 'producer' | 'agency'
  producerId   String?  @map("producer_id")
  agencyId     String?  @map("agency_id")
  category     String   // 'lead_cost' | 'operations' | 'staff' | 'recruiting' | 'travel'
  description  String?
  vendor       String?  // lead_cost only
  quantity     Int?     // lead_cost only, e.g. # of leads
  unitCost     Decimal? @map("unit_cost") @db.Decimal(10, 2) // lead_cost only, e.g. cost/lead
  amount       Decimal  @db.Decimal(10, 2)
  expenseDate  DateTime @map("expense_date") @db.Date

  producer Producer? @relation("ProducerExpenses", fields: [producerId], references: [id])
  agency   Agency?   @relation("AgencyExpenses", fields: [agencyId], references: [id])

  @@map("expense")
}

// Owner draws are NOT expenses — see bob-schema.md. Tracked separately, never netted
// against Net Profit; surfaced on the dashboard as a distinct "cash out" line if desired.
model OwnerDraw {
  id        String   @id @default(uuid())
  agencyId  String   @map("agency_id")
  amount    Decimal  @db.Decimal(10, 2)
  drawDate  DateTime @map("draw_date") @db.Date
  notes     String?

  agency Agency @relation(fields: [agencyId], references: [id])

  @@map("owner_draw")
}
